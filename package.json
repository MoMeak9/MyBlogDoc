{
  "name": "my-blog-doc",
  "version": "2.0.0",
  "description": "A Markdown-first personal blog built with Astro",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-search.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/content.test.mjs tests/paths.test.mjs tests/seo.test.mjs tests/search-query.test.mjs tests/offline-search.test.mjs tests/search-dictionary.test.mjs tests/cover.test.mjs",
    "test:build": "node --test tests/build.test.mjs tests/search-build.test.mjs",
    "commit": "git-cz"
  },
  "config": {
    "commitizen": {
      "path": "git-cz"
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@commitlint/cli": "^17.0.3",
    "@commitlint/config-conventional": "^17.0.3",
    "@types/node": "^22.20.5",
    "cbor-x": "1.6.6",
    "commitizen": "^4.2.4",
    "git-cz": "^4.9.0",
    "pagefind": "1.5.2",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "mermaid": "^11.17.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
