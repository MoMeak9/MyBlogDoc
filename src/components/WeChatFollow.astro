---
import { site } from "../config/site";
import Icon from "./Icon.astro";
import { normalizeBase } from "../lib/paths.mjs";

interface Props {
  id?: string;
  compact?: boolean;
}
const { id, compact = false } = Astro.props;
const qrImage = `${normalizeBase(import.meta.env.BASE_URL)}${site.wechat.qrImage}`;
---

<section
  id={id}
  class:list={["wechat-follow", { "wechat-follow--compact": compact }]}
  aria-label={`关注微信公众号：${site.wechat.name}`}
  data-pagefind-ignore
>
  <div class="wechat-copy">
    <p class="wechat-label"><Icon name="wechat" size={20} /> 微信公众号</p>
    <h2>在微信里，继续阅读。</h2>
    <p class="wechat-description">关注「{site.wechat.name}」，一起交流技术与思考。</p>
    <p class="wechat-instructions">用微信扫一扫；手机上可长按识别，或保存二维码后从微信相册扫码。</p>
  </div>
  <div class="wechat-actions">
    <img
      class="wechat-qr"
      src={qrImage}
      alt="微信公众号「泯泷ML」关注二维码"
      width="430"
      height="430"
      loading="lazy"
      decoding="async"
    />
    <a class="wechat-save" href={qrImage} download="泯泷ML-公众号二维码.jpg">保存二维码</a>
    <p class="wechat-account">{site.wechat.name}</p>
    <button class="button" type="button" data-copy-wechat={site.wechat.name}>
      复制公众号名称
    </button>
    <p class="wechat-status" role="status" aria-live="polite" aria-atomic="true">
      也可在微信「搜一搜 → 公众号」中搜索名称。
    </p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-wechat]").forEach((button) => {
    let resetTimer: ReturnType<typeof setTimeout>;
    button.addEventListener("click", async () => {
      const name = button.dataset.copyWechat;
      const status = button.closest(".wechat-follow")?.querySelector<HTMLElement>(".wechat-status");
      if (!name || !status) return;
      clearTimeout(resetTimer);
      try {
        await navigator.clipboard.writeText(name);
        button.textContent = "已复制";
        status.textContent = "已复制，去微信搜一搜并选择「公众号」。";
        resetTimer = setTimeout(() => { button.textContent = "复制公众号名称"; }, 3000);
      } catch {
        button.textContent = "复制公众号名称";
        status.textContent = `请长按或选中「${name}」手动复制，再到微信搜索。`;
      }
    });
  });
</script>

<style>
  .wechat-follow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(180px, auto);
    align-items: center;
    gap: 40px;
    padding: 40px;
    border: 1px solid var(--border);
    background: var(--surface);
    text-align: left;
    scroll-margin-top: calc(var(--header-height) + 24px);
  }
  .wechat-copy, .wechat-actions { min-width: 0; }
  .wechat-label {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--accent);
    font-size: 12px;
    letter-spacing: .12em;
  }
  h2 { font-size: clamp(24px, 3vw, 36px); margin: 18px 0 16px; }
  .wechat-description { color: var(--text); font-size: 16px; }
  .wechat-instructions { margin-top: 12px; color: var(--muted); font-size: 13px; }
  .wechat-actions { max-width: 240px; text-align: center; }
  .wechat-qr { width: 215px; max-width: 100%; height: auto; margin: 0 auto; background: #fff; color-scheme: light; }
  .wechat-save { display: inline-flex; align-items: center; min-height: 44px; font-size: 12px; color: var(--muted); }
  .wechat-save:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .wechat-account { font-size: 28px; margin-bottom: 16px; font-weight: 500; user-select: all; }
  .wechat-actions .button { width: 100%; letter-spacing: 0; }
  .wechat-actions .button:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .wechat-status { min-height: 44px; margin-top: 12px; font-size: 12px; color: var(--muted); }
  .wechat-follow--compact { margin-top: 36px; padding: 28px; gap: 24px; }
  .wechat-follow--compact h2 { font-size: 24px; }
  @media (max-width: 767px) {
    .wechat-follow { grid-template-columns: minmax(0, 1fr); padding: 24px; gap: 24px; }
    .wechat-actions { max-width: none; }
    .wechat-status { min-height: 0; }
  }
</style>
