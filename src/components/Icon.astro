---
interface Props {
  name?:
    | "arrow"
    | "sun"
    | "moon"
    | "search"
    | "menu"
    | "close"
    | "rss"
    | "github"
    | "email"
    | "bilibili";
  size?: number;
}
const { name = "arrow", size = 18 } = Astro.props;
const paths = {
  arrow: "M5 12h14m-6-6 6 6-6 6",
  sun: "M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6 7 7m10 10 1.4 1.4M5.6 18.4 7 17m10-10 1.4-1.4",
  moon: "M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z",
  search: "m21 21-4.4-4.4",
  menu: "M4 6h16M4 12h16M4 18h16",
  close: "m6 6 12 12M6 18 18 6",
  rss: "M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16",
  github:
    "M9 19c-4 1-4-2-6-2m12 5v-3.4a3 3 0 0 0-.8-2.3c2.7-.3 5.5-1.3 5.5-6A4.7 4.7 0 0 0 18.4 7a4.3 4.3 0 0 0-.1-3.2s-1-.3-3.3 1.2a11.6 11.6 0 0 0-6 0C6.7 3.5 5.7 3.8 5.7 3.8A4.3 4.3 0 0 0 5.6 7a4.7 4.7 0 0 0-1.3 3.3c0 4.7 2.8 5.7 5.5 6a3 3 0 0 0-.8 2.3V22",
  email:
    "M3 7l9 6 9-6M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z",
  bilibili:
    "m8 3 3 3m5-3-3 3M5 6h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2ZM8 11v3m8-3v3m-6 3h4",
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]} />
  {name === "sun" && <circle cx="12" cy="12" r="4" />}
  {name === "search" && <circle cx="10.5" cy="10.5" r="6.5" />}
  {name === "rss" && <circle cx="4" cy="20" r="1" fill="currentColor" />}
</svg>
