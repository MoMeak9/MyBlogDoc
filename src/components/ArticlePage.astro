---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "./PostCard.astro";
import Icon from "./Icon.astro";
import Diagrams from "./Diagrams.astro";
import { ui, dateLabel, type Locale } from "../i18n";
import { getPosts, renderPost, type Post } from "../lib/content";
import { localePath, normalizeBase, postPath } from "../lib/paths.mjs";
import { site } from "../config/site";
interface Props {
  post: Post;
  locale?: Locale;
}
const { post, locale = "zh" } = Astro.props;
const t = ui(locale);
const base = normalizeBase(import.meta.env.BASE_URL);
const { html, headings } = await renderPost(post, locale);
const toc = headings.filter((heading) => heading.depth <= 3);
const allPosts = (await getPosts()).filter((p) => !p.empty && p.id !== post.id);
const related = [
  ...allPosts.filter((p) =>
    p.categories.some((c) => post.categories.includes(c)),
  ),
  ...allPosts.filter(
    (p) => !p.categories.some((c) => post.categories.includes(c)),
  ),
].slice(0, 3);
const editUrl = `https://github.com/MoMeak9/MyBlogDoc/edit/main/src/${post.id.split("/").map(encodeURIComponent).join("/")}.md`;
---

<BaseLayout
  locale={locale}
  title={post.title}
  description={post.description}
  path={`posts/${post.id.split("/").map(encodeURIComponent).join("/")}`}
  article
  post={post}
>
  <header class="article-heading">
    <div class="container narrow">
      <nav
        class="article-breadcrumbs"
        aria-label={locale === "en" ? "Breadcrumb" : "面包屑导航"}
      >
        <ol>
          <li>
            <a href={localePath("", locale, base)}>{t.home}</a>
          </li>
          <li>
            <a href={localePath("blog", locale, base)}>
              {locale === "en" ? "Journal" : "文章"}
            </a>
          </li>
          <li>
            <a href={postPath(post.id, locale, base)} aria-current="page">
              {post.title}
            </a>
          </li>
        </ol>
      </nav>
      <h1
        data-pagefind-body={post.indexable || undefined}
        data-pagefind-meta="title"
        data-pagefind-weight="8"
      >
        {post.title}
      </h1>
      <div class="post-meta">
        <span class="category">{post.categories.join(" / ")}</span>
        <span aria-hidden="true">·</span>
        {post.publishedDate ? (
          <span>
            {locale === "en" ? "Published" : "发布"}{" "}
            <time
              data-date-kind="published"
              datetime={post.publishedDate.toISOString()}
            >
              {dateLabel(post.publishedDate, locale)}
            </time>
          </span>
        ) : undefined}
        {post.modifiedDate ? (
          <span>
            {locale === "en" ? "Updated" : "更新"}{" "}
            <time
              data-date-kind="modified"
              datetime={post.modifiedDate.toISOString()}
            >
              {dateLabel(post.modifiedDate, locale)}
            </time>
          </span>
        ) : undefined}
        {!post.publishedDate && !post.modifiedDate && (
          <span>{t.missingDate}</span>
        )}
        <span aria-hidden="true">·</span>
        <span>
          {post.readMinutes} {t.minuteRead}
        </span>
        <span aria-hidden="true">·</span>
        <span>
          {post.author.explicit
            ? locale === "en"
              ? "Author"
              : "作者"
            : locale === "en"
              ? "Notes by"
              : "笔记整理"}{" "}
          ·{" "}
          {post.author.url ? (
            <a href={post.author.url} rel="noopener noreferrer" target="_blank">
              {post.author.name}
            </a>
          ) : (
            post.author.name
          )}
        </span>
      </div>
    </div>
  </header>
  <div class="container article-grid">
    <div class="article-content">
      <article
        class="prose"
        lang={post.language}
        data-pagefind-body={post.indexable || undefined}
        data-pagefind-id={encodeURIComponent(post.id)}
        data-pagefind-meta="id[data-pagefind-id]"
      >
        {post.empty ? <p>{t.empty}</p> : <Fragment set:html={html} />}
      </article>
      <div class="article-bottom">
        <span>
          {locale === "en" ? "Maintained by" : "维护与整理"} ·{" "}
          <a href={localePath("about", locale, base)}>{site.author.name}</a>
        </span>
        <a
          class="text-link"
          href={editUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.edit}
          <Icon size={14} />
        </a>
      </div>
      {post.sources.length > 0 && (
        <aside
          class="article-sources"
          aria-label={locale === "en" ? "Sources" : "文章来源"}
        >
          <h2>
            {locale === "en" ? "Sources and attribution" : "文章来源与参考"}
          </h2>
          <ul>
            {post.sources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer">
                  {source.title || source.url}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>
    {toc.length > 0 && (
      <aside class="toc">
        <details class="toc-panel">
          <summary class="toc-toggle">
            <span class="section-label">{t.toc}</span>
            <span class="toc-action">
              <span class="toc-show">{t.tocShow}</span>
              <span class="toc-hide">{t.tocHide}</span>
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
                focusable="false"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </span>
          </summary>
          <nav class="toc-nav" aria-label={t.toc}>
            {toc.map((heading) => (
              <a class={`depth-${heading.depth}`} href={`#${heading.slug}`}>
                {heading.text}
              </a>
            ))}
          </nav>
        </details>
      </aside>
    )}
  </div>
  {related.length > 0 && (
    <section class="section collections-section">
      <div class="container">
        <div class="section-heading">
          <h2>{t.related}</h2>
          <a class="text-link accent" href={localePath("blog", locale, base)}>
            {t.allPosts}
            <Icon size={16} />
          </a>
        </div>
        <div class="journal-grid">
          {related.map((item, index) => (
            <PostCard post={item} locale={locale} index={index} />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
{/^\s*(?:`{3,}|~{3,})mermaid\b/im.test(post.body) && <Diagrams />}
<script>
  const tocPanel = document.querySelector<HTMLDetailsElement>(".toc-panel");
  if (tocPanel) {
    const desktop = window.matchMedia("(min-width: 1024px)");
    const tocToggle = tocPanel.querySelector<HTMLElement>(".toc-toggle");
    const tocNav = tocPanel.querySelector<HTMLElement>(".toc-nav");
    let pendingTarget: HTMLElement | null = null;
    const syncTocLayout = () => {
      pendingTarget = null;
      if (
        !desktop.matches &&
        document.activeElement !== tocToggle &&
        tocPanel.contains(document.activeElement)
      ) {
        tocToggle?.focus({ preventScroll: true });
      }
      tocPanel.open = desktop.matches;
    };
    syncTocLayout();
    desktop.addEventListener("change", syncTocLayout);
    window.addEventListener("pageshow", (event) => {
      if (!event.persisted) syncTocLayout();
    });
    tocNav?.addEventListener("click", (event) => {
      pendingTarget = null;
      if (
        desktop.matches ||
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return;
      }
      const link =
        event.target instanceof Element
          ? event.target.closest<HTMLAnchorElement>('a[href^="#"]')
          : null;
      if (!link || !tocNav?.contains(link)) return;
      try {
        pendingTarget = document.getElementById(
          decodeURIComponent(new URL(link.href).hash.slice(1)),
        );
      } catch {
        pendingTarget = document.getElementById(link.hash.slice(1));
      }
    });
    document.addEventListener("blog:anchor-complete", (event) => {
      const { target, focus } = (
        event as CustomEvent<{
          target: HTMLElement;
          focus: boolean;
        }>
      ).detail;
      if (!focus || target !== pendingTarget) return;
      // Clear before requesting realignment so it cannot trigger another close.
      pendingTarget = null;
      if (desktop.matches || !tocPanel.open) return;
      tocPanel.open = false;
      document.dispatchEvent(new CustomEvent("blog:anchor-layout-change"));
    });
  }
</script>
<style>
  .article-breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    margin: 0 0 20px;
    padding: 0;
    list-style: none;
    font-size: 12px;
    color: var(--muted);
  }
  .article-breadcrumbs li {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .article-breadcrumbs li + li::before {
    content: "/";
    margin-right: 8px;
    opacity: 0.6;
  }
  .article-sources {
    margin-block: 24px;
    padding-block: 20px;
    border-top: 1px solid var(--border);
    overflow-wrap: anywhere;
  }
  .article-sources h2 {
    margin-bottom: 12px;
    font-size: 16px;
  }
  .article-sources ul {
    padding-left: 20px;
    line-height: 1.8;
  }
  .article-sources a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .toc-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
  }
  .toc-toggle::-webkit-details-marker {
    display: none;
  }
  .toc-toggle .section-label {
    margin-bottom: 0;
  }
  .toc-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    font-size: 12px;
    color: var(--muted);
  }
  .toc-hide,
  .toc-panel[open] .toc-show {
    display: none;
  }
  .toc-panel[open] .toc-hide {
    display: inline;
  }
  .toc-panel[open] .toc-action svg {
    transform: rotate(180deg);
  }
  .toc-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
</style>
<script
  define:vars={{
    copyLabel: t.copy,
    copiedLabel: t.copied,
    failureLabel: t.copyFailed,
  }}
>
  document.querySelectorAll(".prose pre").forEach((pre) => {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "copy-button";
    button.textContent = copyLabel;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(
          pre.querySelector("code")?.textContent || "",
        );
        button.textContent = copiedLabel;
      } catch {
        button.textContent = failureLabel;
      }
      setTimeout(() => {
        button.textContent = copyLabel;
      }, 2000);
    });
    pre.prepend(button);
  });
</script>
