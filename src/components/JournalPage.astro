---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "./PostCard.astro";
import Icon from "./Icon.astro";
import { ui, type Locale } from "../i18n";
import { getPosts } from "../lib/content";
interface Props {
  locale?: Locale;
}
const { locale = "zh" } = Astro.props;
const t = ui(locale);
const posts = (await getPosts()).filter((post) => !post.empty);
const categories = [...new Set(posts.flatMap((post) => post.categories))].sort(
  (a, b) => a.localeCompare(b, "zh-Hans"),
);
---

<BaseLayout locale={locale} title={t.journal} path="blog">
  <section class="page-heading">
    <div class="container">
      <p class="section-label">{t.archiveLabel}</p>
      <h1>{t.journal}</h1>
      <p>{t.journalDescription}</p>
    </div>
  </section>
  <section class="journal-body">
    <div class="container">
      <div class="filter-bar">
        <label class="search-box">
          <Icon name="search" size={18} />
          <span class="sr-only">{t.search}</span>
          <input
            type="search"
            id="article-search"
            placeholder={t.searchPlaceholder}
            aria-label={t.search}
          />
        </label>
        <p class="results-count" aria-live="polite">
          <span id="result-count">{posts.length}</span> {t.results}
        </p>
      </div>
      <div class="chips" aria-label={t.collections}>
        <button
          type="button"
          class="chip active"
          data-category=""
          aria-pressed="true"
        >
          {t.all}
        </button>
        {categories.map((category) => (
          <button
            type="button"
            class="chip"
            data-category={category}
            aria-pressed="false"
          >
            {category}
          </button>
        ))}
      </div>
      <div class="journal-grid">
        {posts.map((post, index) => (
          <PostCard post={post} locale={locale} index={index} searchable />
        ))}
      </div>
      <div class="empty-results" hidden>
        <h2>{t.noResults}</h2>
        <p>{t.trySearch}</p>
        <button type="button" class="button button-outline" id="reset-filters">
          {t.reset}
        </button>
      </div>
      <nav class="pagination" aria-label={t.page} hidden>
        <button type="button" class="button button-outline" id="prev-page">
          {t.previous}
        </button>
        <span id="page-status" aria-live="polite"></span>
        <button type="button" class="button button-outline" id="next-page">
          {t.next}
        </button>
      </nav>
    </div>
  </section>
</BaseLayout>
<script>
  const cards = [...document.querySelectorAll<HTMLElement>("[data-post]")];
  const input = document.querySelector<HTMLInputElement>("#article-search");
  const chips = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-category]"),
  ];
  const count = document.querySelector("#result-count");
  const pagination = document.querySelector<HTMLElement>(".pagination");
  const status = document.querySelector("#page-status");
  const previous = document.querySelector<HTMLButtonElement>("#prev-page");
  const next = document.querySelector<HTMLButtonElement>("#next-page");
  const empty = document.querySelector<HTMLElement>(".empty-results");
  const params = new URLSearchParams(location.search);
  let category = params.get("category") || "";
  let page = 1;
  const pageSize = 12;
  if (input) input.value = params.get("q") || "";
  if (!chips.some((chip) => chip.dataset.category === category)) category = "";
  const update = () => {
    const query = input?.value.trim().toLocaleLowerCase() || "";
    const words = query.split(/\s+/).filter(Boolean);
    const filtered = cards.filter(
      (card) =>
        (!category ||
          JSON.parse(card.dataset.categories || "[]").includes(category)) &&
        words.every((word) => card.dataset.search?.includes(word)),
    );
    const pages = Math.max(1, Math.ceil(filtered.length / pageSize));
    page = Math.min(page, pages);
    const visible = new Set(
      filtered.slice((page - 1) * pageSize, page * pageSize),
    );
    cards.forEach((card) => {
      card.hidden = !visible.has(card);
    });
    chips.forEach((chip) => {
      const active = chip.dataset.category === category;
      chip.classList.toggle("active", active);
      chip.setAttribute("aria-pressed", String(active));
    });
    if (count) count.textContent = String(filtered.length);
    if (empty) empty.hidden = filtered.length !== 0;
    if (pagination) pagination.hidden = pages <= 1;
    if (status) status.textContent = `${page} / ${pages}`;
    if (previous) previous.disabled = page === 1;
    if (next) next.disabled = page === pages;
    const search = new URLSearchParams();
    if (query) search.set("q", input?.value.trim() || "");
    if (category) search.set("category", category);
    history.replaceState(
      null,
      "",
      `${location.pathname}${search.size ? `?${search}` : ""}`,
    );
  };
  input?.addEventListener("input", () => {
    page = 1;
    update();
  });
  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      category = chip.dataset.category || "";
      page = 1;
      update();
    }),
  );
  document.querySelector("#reset-filters")?.addEventListener("click", () => {
    category = "";
    page = 1;
    if (input) input.value = "";
    update();
  });
  previous?.addEventListener("click", () => {
    page--;
    update();
    document.querySelector(".filter-bar")?.scrollIntoView({ block: "start" });
  });
  next?.addEventListener("click", () => {
    page++;
    update();
    document.querySelector(".filter-bar")?.scrollIntoView({ block: "start" });
  });
  update();
</script>
